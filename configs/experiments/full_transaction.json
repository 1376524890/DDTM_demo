  "bond": {
    "g_dev": 60.0, "eps_s": 1.0, "p_e_bond": 1.0, "p_e_f": 0.3,
    "lambda_s": 0.5, "f_s": 10.0, "kappa_s": 0.1, "t_pre": 1.0, "t_post": 1.0
  },
  "buyer": { "w_b_rem": 500.0, "c_i": 20.0, "c_r_pay": 5.0,
             "c_b_use_cap": 2.0, "r_b_post": 5.0 },
  "seller": { "c_marg": 5.0, "c_a_s_pay": 0.0, "c_r_s_pay": 3.0,
              "r_s_post": 4.0, "oc_s": 6.0, "pi_s0": 10.0 },
  "pricing": { "beta_bar": 0.5 },
  "initial_balances": {
    "E_B^P": 500.0, "E_S^A": 100.0, "E_B^A": 100.0,
    "B_S^pre": 200.0, "B_S^*": 200.0, "B_B^use": 0.0
  },
  "seller_breach": false
}
