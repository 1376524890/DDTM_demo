# ============================================================
# VALOR 分层忽略规则（对齐规范 §53 目录结构 / 归档规范）
# 先忽略广泛模式，再局部豁免；实验大文件与可再生成输出一律不入库。
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
*.so

# ---- 实验数据（大文件，不入库）----
data/raw/
data/prepared/
*.npz
*.parquet
*.arff

# ---- 实验输出（可再生成）----
raw/
runs/
reports/figures/
*.png
*.pdf
logs/

# ---- 本地配置（含密钥，不入库）----
.env
configs/local/

# ---- 测试/工具缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 编辑器/系统 ----
.DS_Store
*.swp
.idea/
.vscode/
