{
  "schema_version": "1",
  "dataset": {
    "name": "breast_cancer",
    "seed": 0,
    "base_train_frac": 0.5,
    "seller_pool_frac": 0.2,
    "valuation_validation_frac": 0.15,
    "n_batches": 4,
    "rows_per_batch": 20
  },
  "payoff": { "r_tn": 1.0, "r_fp": -2.0, "r_fn": -5.0, "r_tp": 3.0 },
  "entitlement": { "grant_authority": true, "compliant": true },
  "exposure": 2.0,
  "exclusivity": false,
  "competition_sensitivity": 1.0,
  "lower_bound_adj": 0.0,
  "loss_matrix": {
    "ACCEPT":    { "G": 0.0,  "L": 5.0,  "B": 50.0 },
    "REJECT":    { "G": 10.0, "L": 1.0,  "B": 0.0  },
    "TERMINATE": { "G": 10.0, "L": 1.0,  "B": 1.0  }
  },
  "prior": { "pi_b": 0.25, "q_l": 0.2 },
  "likelihood": {
    "PASS":          { "G": 0.85, "L": 0.75, "B": 0.10 },
